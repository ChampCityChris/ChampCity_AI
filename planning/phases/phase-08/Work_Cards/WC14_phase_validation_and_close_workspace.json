  "workspace": {
    "id": "phase-validation",
    "layout": [
      "Phase document population browser",
      "Phase_Closeout preview and disposition"
    ],
    "embeddedArchitectRequired": false
  },
  "entryRequirements": [
    "Approved Phase_Interview",
    "Approved Phase_Planning and Work_Card_Plan",
    "Approved Validation_Record for every required Formal Work Card",
    "Every other candidate explicitly resolved"
  ],
  "reviewPopulation": [
    "Phase_Interview",
    "Phase_Planning",
    "Work_Card_Plan",
    "Formal Work Cards",
    "Implementer Reports",
    "Architect report dispositions",
    "Repair Work Cards and reports",
    "Validation Records",
    "Candidate resolution decisions",
    "Observations, risks, decisions, and evidence"
  ],
  "closeoutArtifact": {
    "path": "planning/phases/<phase-id>/Phase_Closeouts/PHASE_<phase-number>_CLOSEOUT_<slug>.*",
    "requiredFields": [
      "phase identity and intended outcome",
      "closure decision",
      "Operator closure rationale",
      "completed Work Card and validation summary",
      "known limitations",
      "unresolved, deferred, superseded, or carried-forward matters",
      "observation, risk, and decision reconciliation",
      "Phase Map or Project Roadmap impact",
      "Operator approval statement",
      "Document.Status"
    ]
  },
  "completionRule": "Phase Close completes only when Phase_Closeout is Approved and closureDecision is Close.",
  "returnBehavior": "Return to Project Building and derive the next incomplete phase from the Approved Phase Map and Approved Phase Closeouts.",
  "prohibitedScope": [
    "Repeated Work Card validation testing",
    "Project Validation or Project Close",
    "Second Phase Close approval",
    "Operator_Phase_Closeout_Approval artifacts",
    "Next-phase activation artifacts",
    "Duplicate corpus snapshots",
    "Hidden lifecycle completion or active-phase state",
    "Route tokens, role gates, approval queues, hashes, execution runs, or decision timelines",
    "Dependency changes",
    "Git operations"
  ],
  "validation": [
    "npm run typecheck",
    "npm run build",
    "npm test"
  ],
  "implementerReport": "planning/phases/phase-08/Implementer_Reports/IMPLEMENTER_REPORT_WC14_phase_validation_and_close_workspace.md",
