{
  "workCardId": "WC02",
  "phaseId": "phase-08",
  "title": "Project Intake Capture and Architect Interview Prompt Generation",
  "status": "approved_design_execution_deferred",
  "owner": "Implementer after Operator release",
  "risk": "medium",
  "dependsOn": [
    "WC01"
  ],
  "executionAuthorized": false,
  "executionReleaseCondition": "WC01 is accepted and the Operator explicitly releases WC02 as the active sequential Phase 08 card.",
  "gitMutationAuthorized": false,
  "purpose": "Implement the Project Intake Capture workspace, fixed Operator questionnaire, durable Project Intake pair, and deterministic Architect Interview Prompt pair.",
  "sourceDesignDocuments": [
    "planning/project/Design_Documents/NESTED_PROJECT_PHASE_WORK_CARD_LIFECYCLE_MODEL.md",
    "planning/project/Design_Documents/PROJECT_INTAKE_LIFECYCLE_AND_WORKSPACE_DEFINITION.md"
  ],
  "lifecycleLocation": {
    "level": "project",
    "stage": "intake"
  },
  "workspace": {
    "id": "project-intake-capture",
    "label": "Project Intake Capture",
    "registryBacked": true,
    "orderBoundary": "Before Architect Interview"
  },
  "fields": [
    {
      "id": "projectName",
      "control": "short_text",
      "required": true
    },
    {
      "id": "projectPurpose",
      "control": "long_text",
      "required": true
    },
    {
      "id": "desiredOutcome",
      "control": "long_text",
      "required": true
    },
    {
      "id": "projectType",
      "control": "dropdown",
      "required": true
    },
    {
      "id": "projectRepository",
      "control": "repository_or_folder_selector",
      "required": true
    },
    {
      "id": "existingSourceOrPlanning",
      "control": "yes_no",
      "required": true
    },
    {
      "id": "knownConstraints",
      "control": "long_text",
      "required": false
    },
    {
      "id": "repositoryReviewContext",
      "control": "long_text",
      "required": false,
      "visibleWhen": "existingSourceOrPlanning=yes"
    }
  ],
  "projectTypeValues": [
    "Desktop application",
    "Web application",
    "Mobile application",
    "CLI or tool",
    "Library or service",
    "Documentation or process",
    "Other"
  ],
  "outputs": [
    "planning/project/Project_Intake/PROJECT_INTAKE_<project-slug>.md",
    "planning/project/Project_Intake/PROJECT_INTAKE_<project-slug>.json",
    "planning/project/Project_Architect_Interview_Prompts/PROJECT_ARCHITECT_INTERVIEW_PROMPT_<project-slug>.md",
    "planning/project/Project_Architect_Interview_Prompts/PROJECT_ARCHITECT_INTERVIEW_PROMPT_<project-slug>.json"
  ],
  "reconciliationBehavior": {
    "trigger": "existingSourceOrPlanning=yes",
    "defaultStandaloneArtifact": false,
    "promptRequirements": [
      "Architect reviews repository through ChampCity MCP",
      "Verified repository facts are distinguished from Operator statements and recommendations",
      "Material findings use repository-relative paths where practical",
      "Later Project Profile and Roadmap begin from verified current state"
    ]
  },
  "writeRequirements": [
    "Main/preload mediated repository selection",
    "Synchronized Markdown/JSON pair writes",
    "Deterministic filesystem-safe project slug",
    "Deterministic prompt generation",
    "Prompt regeneration after intake edits",
    "No silent partial pair success",
    "No unresolved prompt-only resolver gate"
  ],
  "prohibitedScope": [
    "Embedded browser",
    "MCP browser handoff",
    "Live Architect interview",
    "Interview document preview or disposition",
    "Project Planning generation",
    "Lifecycle transitions or state store",
    "Repository reconciliation execution",
    "Provider SDKs, API keys, cloud services, databases, or new dependencies",
    "Git operations"
  ],
  "validation": [
    "npm run typecheck",
    "npm run build",
    "npm test"
  ],
  "implementerReport": "planning/phases/phase-08/Implementer_Reports/IMPLEMENTER_REPORT_WC02_project_intake_capture_and_architect_interview_prompt_generation.md",
  "documentDisposition": {
    "status": "Approved"
  }
}
