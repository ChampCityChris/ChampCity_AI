{
  "name": "champcity-ai",
  "version": "0.1.0",
  "description": "Alpha Electron desktop app for the ChampCity A/I Architect / Implementer workflow.",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc && vite build && node scripts/copy-renderer-assets.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:full",
    "test:unit": "npm run build && npm run test:unit:built",
    "test:unit:built": "node --test --test-concurrency=1",
    "test:repository": "node --test --test-concurrency=1 test/repository/test-suite-integrity.test.cjs test/repository/validation-runner.test.cjs",
    "test:renderer": "npm run build && npm run test:renderer:built",
    "test:renderer:built": "electron test/renderer/operator-approval-workspace.mounted.cjs",
    "test:full": "npm run build && npm run test:unit:built && npm run test:renderer:built",
    "wc04:registry": "node scripts/wc04-artifact-registry-repair.mjs",
    "validate:codex": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/codex-validate.ps1 -Suite full",
    "validate:codex:unit": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/codex-validate.ps1 -Suite unit",
    "validate:codex:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/codex-validate.ps1 -Suite build"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.3.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.5.4",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
