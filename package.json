    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.3.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.5.4",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
