{
  "name": "champcity-ai-work-card-mvp",
  "version": "0.1.0",
  "description": "Foundation scaffold for the ChampCity A/I Work Card MVP Electron desktop app.",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc && node scripts/copy-renderer-assets.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "test:work-cards": "npm run build && node scripts/verify-work-card-fixture.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "electron": "^31.3.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
