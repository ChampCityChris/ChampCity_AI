{
  "name": "champcity-ai",
  "version": "0.1.0-beta.3",
  "description": "ChampCity A/I Desktop for governed software planning, implementation, review, validation, and local agent orchestration.",
  "author": "ChampCityChris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChampCityChris/ChampCity_AI.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "main": "dist/main/bootstrap.js",
  "private": true,
  "scripts": {
    "build": "tsc && vite build && node scripts/copy-branding-assets.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:full",
    "test:unit": "npm run build && npm run test:unit:built",
    "test:unit:built": "node --test --test-concurrency=1 \"test/**/*.test.cjs\"",
    "test:full": "npm run build && npm run test:unit:built",
    "package:win:dir": "npm run build && electron-builder --win dir --x64",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "validate:package:win": "node scripts/validate-windows-package-metadata.cjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "24.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.5.4",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex": "^0.146.0",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.4"
  }
}
