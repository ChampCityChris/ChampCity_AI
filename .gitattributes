# Normalize text files in the repository and make line-ending behavior
# independent of contributor-specific Git configuration.
* text=auto

# Repository text uses LF.
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.nsh text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Native Windows command scripts retain CRLF when introduced.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and generated package formats must never receive text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.node binary
*.asar binary
*.woff binary
*.woff2 binary
